CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_SYSLOG_DEVPATH="/dev/console"
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="nrf5340-dk"
CONFIG_ARCH_BOARD_NRF5340_DK=y
CONFIG_ARCH_CHIP="nrf53"
CONFIG_ARCH_CHIP_NRF5340=y
CONFIG_ARCH_CHIP_NRF5340_CPUAPP=y
CONFIG_ARCH_CHIP_NRF53=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_STDARG_H=y
CONFIG_BOARD_LOOPSPERMSEC=5500
CONFIG_EXPERIMENTAL=y
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_LINE_MAX=64
CONFIG_MM_REGIONS=2
CONFIG_NRF53_APPCORE=y
CONFIG_NRF53_GPIOTE=y
CONFIG_NRF53_OSCILLATOR_LFXO=y
CONFIG_NRF53_QSPI=y
CONFIG_NRF53_UART0=y
CONFIG_NRF53_USE_HFCLK192M=y
CONFIG_INTELHEX_BINARY=y
CONFIG_BOARDCTL=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_SYSTEM_NSH=y
CONFIG_RAM_SIZE=524288
CONFIG_RAM_START=0x20000000

# QSPI: use RXDELAY=0 (nRF7002 default, Zephyr DTS binding default)
# RXDELAY=2 causes Quad-I/O reads to return 0xaaaa8088 garbage (bit-shifted data)
CONFIG_NRF53_QSPI_RXDELAY=0

# IEEE 802.11 WiFi - nRF7002
CONFIG_DRIVERS_WIRELESS=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_IEEE80211_NRF7002=y

# Network stack
CONFIG_NET=y
CONFIG_NET_ETHERNET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_NET_UDP=y
CONFIG_NET_UDP_WRITE_BUFFERS=y
CONFIG_NET_UDP_NWRBCHAINS=16
CONFIG_NET_UDP_ALLOC_WRBCHAINS=1
CONFIG_NET_DHCP_CLIENT=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETINIT_MACADDR_1=0x00000001
CONFIG_NETINIT_MACADDR_2=0x00000001

# Work queues (required by nRF7002 OSAL tasklet/IRQ)
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_HPWORKPRIORITY=249
CONFIG_SCHED_LPWORKPRIORITY=100
CONFIG_SCHED_HPNTHREADS=1

# Ping and network tools
CONFIG_SYSTEM_PING=y
CONFIG_SYSTEM_PING_STACKSIZE=2048

# iperf bandwidth test
CONFIG_NETUTILS_IPERF=y
CONFIG_NETUTILS_NETLIB=y
CONFIG_LIBC_FLOATINGPOINT=y
