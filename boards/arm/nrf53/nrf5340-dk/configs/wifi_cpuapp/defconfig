# Wireless tools
CONFIG_BUILTIN=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_WIRELESS_WAPI=y
CONFIG_WIRELESS_WAPI_CMDTOOL=y
CONFIG_WIRELESS_WAPI_PROGNAME="wapi"
CONFIG_WIRELESS_WAPI_STACKSIZE=4096
CONFIG_WIRELESS_WAPI_SCAN_MAX_DATA=4096
CONFIG_NETINIT_WAPI_STAMODE=2
CONFIG_NETINIT_WAPI_STAMODE_INFRA=y
CONFIG_NETINIT_WAPI_AUTHWPA=4
CONFIG_NETINIT_WAPI_AUTHWPA_WPA2=y
CONFIG_NETINIT_WAPI_CIPHERMODE=8
CONFIG_NETINIT_WAPI_CIPHERMODE_CCMP=y
CONFIG_NETINIT_WAPI_ALG=3
CONFIG_NETINIT_WAPI_ALG_CCMP=y
CONFIG_NETINIT_WAPI_SSID=""
CONFIG_NETINIT_WAPI_PASSPHRASE=""
CONFIG_NETDEV_IOCTL=y
CONFIG_NETDEV_WIRELESS_IOCTL=y


# File system (for procfs and potential firmware loading)
CONFIG_FS_PROCFS=y
CONFIG_NSH_PROC_MOUNTPOINT="/proc"

# MTD — deliberately NOT enabling CONFIG_MTD_MX25RXX for wifi_cpuapp.
# The MX25 flash uses QSPI with CS=P0.18.  The nRF7002 WiFi chip also uses QSPI
# but with a separate CS pin.  Enabling MX25 causes nrf53_mx25_initialize() to
# claim the QSPI bus and configure it for the MX25 CS pin before nrf7002_initialize()
# runs, resulting in all nRF7002 QSPI register accesses seeing garbage (QSPI reads
# hit the MX25 flash instead of the nRF7002 RPU).
# If MTD is needed for other purposes, add a dual-CS QSPI driver instead.
CONFIG_MTD=y
# CONFIG_MTD_MX25RXX is not set
CONFIG_SCHED_LPWORKSTACKSIZE=8192
